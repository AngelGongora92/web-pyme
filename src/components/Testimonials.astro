---
import { getSiteData } from '../data/getSiteData';
const siteData = await getSiteData();
import { Image } from 'astro:assets';
---

<section class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{siteData.sectionTitles?.testimonials || 'Lo que dicen nuestros clientes'}</h2>
        <div class="w-24 h-1.5 bg-brand-primary rounded-full"></div>
      </div>
      <a href={siteData.contact.mapsUrl} target="_blank" rel="noopener noreferrer" class="text-brand-primary font-semibold hover:underline flex items-center gap-2">
        Dejar opinión en Google
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
      </a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {siteData.testimonials.map(test => (
        <div class="bg-gray-50 p-8 rounded-2xl border border-gray-100">
          <div class="flex gap-1 text-yellow-400 mb-4">
            {Array.from({ length: test.rating }).map(() => (
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            ))}
          </div>
          <p class="text-gray-600 italic mb-6">"{test.text || test.content}"</p>
          <div class="flex items-center gap-4">
            {test.avatar ? (
              <Image src={test.avatar} alt={test.name} width={48} height={48} class="w-12 h-12 rounded-full object-cover" />
            ) : (
              <div class="w-12 h-12 rounded-full bg-brand-primary/20 text-brand-primary flex items-center justify-center font-bold text-lg">
                {test.name.charAt(0)}
              </div>
            )}
            <div>
              <span class="font-bold text-gray-900 block">{test.name}</span>
              {test.role && <span class="text-xs text-gray-500 uppercase tracking-wide">{test.role}</span>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
