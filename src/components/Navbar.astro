---
import { getSiteData } from '../data/getSiteData';
const siteData = await getSiteData();
import { Image } from 'astro:assets';
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="container mx-auto px-4 py-3 flex justify-between items-center">
    <a href="/" class="flex items-center gap-3">
      <Image src={siteData.images.logo} alt={siteData.name} width={48} height={48} class="h-10 md:h-12 w-auto object-contain rounded-md" />
      <span class="text-lg md:text-xl font-bold text-brand-primary truncate max-w-[150px] md:max-w-none">{siteData.name}</span>
    </a>
    
    <!-- Desktop Menu -->
    <div class="hidden md:flex items-center gap-6">
      {siteData.schedule?.showIndicator && (
        <div id="status-badge" class="flex items-center gap-1.5 opacity-0 transition-opacity duration-300">
          <span class="w-2 h-2 rounded-full bg-gray-300 indicator"></span>
          <span class="text-xs text-gray-400 text-label">...</span>
        </div>
      )}
      <a href={`tel:${siteData.contact.phone}`} class="font-medium text-gray-600 hover:text-brand-primary transition-colors flex items-center gap-2">
        {siteData.contact.phone}
      </a>
      <a href={`https://wa.me/${siteData.contact.whatsapp}`} target="_blank" rel="noopener noreferrer" class="bg-brand-cta text-white px-6 py-2 rounded-full font-bold hover:opacity-90 transition-opacity">
        Cotizar
      </a>
    </div>

    <!-- Mobile CTA -->
    <div class="md:hidden flex items-center gap-2">
      {siteData.schedule?.showIndicator && (
        <div id="status-badge-mobile" class="flex items-center gap-1 opacity-0 transition-opacity duration-300 mr-1">
          <span class="w-2 h-2 rounded-full bg-gray-300 indicator-mobile"></span>
        </div>
      )}
      <a href={`tel:${siteData.contact.phone}`} class="text-gray-600 p-2 bg-gray-100 rounded-full hover:bg-gray-200 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
      </a>
      <a href={`https://wa.me/${siteData.contact.whatsapp}`} target="_blank" rel="noopener noreferrer" class="bg-brand-cta text-white px-4 py-1.5 text-sm rounded-full font-bold hover:opacity-90 transition-opacity">
        Cotizar
      </a>
    </div>
  </div>
</header>

<script define:vars={{ schedule: siteData.schedule }}>
  if (schedule && schedule.showIndicator) {
    const badge = document.getElementById('status-badge');
    const indicator = badge.querySelector('.indicator');
    const label = badge.querySelector('.text-label');

    const badgeMobile = document.getElementById('status-badge-mobile');
    
    const checkStatus = () => {
      const now = new Date();
      const hour = now.getHours();
      const minutes = now.getMinutes();
      const currentDecimalTime = hour + (minutes / 60);
      const day = now.getDay().toString(); // 0 is Sunday
      
      let isOpen = false;
      const todaySchedule = schedule.hours[day];
      
      if (todaySchedule && todaySchedule.open && todaySchedule.close) {
        const openParts = todaySchedule.open.split(':');
        const closeParts = todaySchedule.close.split(':');
        const openDecimal = parseInt(openParts[0]) + (parseInt(openParts[1] || 0) / 60);
        const closeDecimal = parseInt(closeParts[0]) + (parseInt(closeParts[1] || 0) / 60);
        
        if (currentDecimalTime >= openDecimal && currentDecimalTime < closeDecimal) {
          isOpen = true;
        }
      }
      
      if (isOpen) {
        indicator.className = 'w-2 h-2 rounded-full bg-green-500 animate-pulse';
        label.textContent = 'Abierto';
        label.className = 'text-xs text-gray-500 font-medium';
        
        badgeMobile.innerHTML = '<span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> <span class="text-[10px] text-gray-500 font-medium uppercase">Abierto</span>';
      } else {
        indicator.className = 'w-2 h-2 rounded-full bg-red-400';
        label.textContent = 'Cerrado';
        label.className = 'text-xs text-gray-400 font-medium';
        
        badgeMobile.innerHTML = '<span class="w-2 h-2 rounded-full bg-red-400"></span> <span class="text-[10px] text-gray-400 font-medium uppercase">Cerrado</span>';
      }
      
      // Fade in to prevent FOUC
      badge.style.opacity = '1';
      badgeMobile.style.opacity = '1';
    };
    
    checkStatus();
    // Re-check every minute
    setInterval(checkStatus, 60000);
  }
</script>
