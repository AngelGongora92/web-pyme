---
import { getSiteData } from '../data/getSiteData';
const siteData = await getSiteData();
import { Image } from 'astro:assets';
---

<section class="relative bg-brand-neutral overflow-hidden">
  <div class="container mx-auto px-4 pt-4 pb-16 md:pt-6 md:pb-24 flex flex-col md:flex-row items-center gap-12">
    <div class="md:w-1/2 flex flex-col items-start z-10">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-gray-900 leading-tight mb-6 mt-4 md:mt-0">
        {siteData.headline}
      </h1>
      <p class="text-lg text-gray-600 mb-8 max-w-xl">
        {siteData.subheadline}
      </p>
      
      <div class="flex flex-col items-start gap-3">
        <a href={`https://wa.me/${siteData.contact.whatsapp}?text=${encodeURIComponent((siteData.hero || {}).whatsappDefaultMessage)}`} target="_blank" rel="noopener noreferrer" class="bg-brand-cta text-white font-bold text-lg px-8 py-4 rounded-full shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all flex items-center gap-3">
          {(siteData.hero || {}).ctaText}
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.964 9.964 0 0 0 1.533 5.303L2 22l4.89-1.253a9.92 9.92 0 0 0 5.122 1.417h.004c5.505 0 9.988-4.478 9.989-9.984 0-2.669-1.037-5.176-2.922-7.062A9.935 9.935 0 0 0 12.012 2z"/></svg>
        </a>
        {siteData.promoBadge && (
          <div class="flex items-center gap-2 text-sm text-gray-500 font-medium ml-2">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            {siteData.promoBadge}
          </div>
        )}
      </div>
    </div>
    
    <div class="md:w-1/2 relative w-full aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl">
      <Image src={siteData.images.hero} alt={siteData.headline} width={800} height={600} class="w-full h-full object-cover" />
    </div>
  </div>
</section>
