---
import { getSiteData } from '../data/getSiteData';
const siteData = await getSiteData();
const year = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-400 py-8 border-t-4 border-brand-primary text-sm">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div>
        <h3 class="text-lg font-bold text-white mb-3">{siteData.name}</h3>
        <p class="text-gray-500 mb-4 text-xs">{siteData.description}</p>
        <div class="flex gap-3">
          {siteData.social.facebook && (
            <a href={siteData.social.facebook} target="_blank" rel="noopener noreferrer" class="bg-gray-800 p-2 rounded-full hover:bg-brand-primary hover:text-white transition-colors" aria-label="Facebook">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          )}
          {siteData.social.instagram && (
            <a href={siteData.social.instagram} target="_blank" rel="noopener noreferrer" class="bg-gray-800 p-2 rounded-full hover:bg-brand-primary hover:text-white transition-colors" aria-label="Instagram">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          )}
          {siteData.social.tiktok && (
            <a href={siteData.social.tiktok} target="_blank" rel="noopener noreferrer" class="bg-gray-800 p-2 rounded-full hover:bg-brand-primary hover:text-white transition-colors" aria-label="TikTok">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
            </a>
          )}
          {siteData.social.twitter && (
            <a href={siteData.social.twitter} target="_blank" rel="noopener noreferrer" class="bg-gray-800 p-2 rounded-full hover:bg-brand-primary hover:text-white transition-colors" aria-label="X / Twitter">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.008 5.92H5.078z"/></svg>
            </a>
          )}
        </div>
      </div>
      <div>
        <h4 class="text-base font-bold text-white mb-3">Enlaces</h4>
        <ul class="space-y-1.5 text-xs">
          <li><a href="#servicios" class="hover:text-brand-primary transition-colors">Servicios</a></li>
          <li><a href="#galeria" class="hover:text-brand-primary transition-colors">Galería</a></li>
          <li><a href="#contacto" class="hover:text-brand-primary transition-colors">Contacto</a></li>
          <li><a href="#" class="hover:text-brand-primary transition-colors">Aviso de Privacidad</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-base font-bold text-white mb-3">Servicios</h4>
        <ul class="space-y-1.5 text-xs">
          {siteData.services.map(s => (
            <li><a href={`https://wa.me/${siteData.contact.whatsapp}?text=${encodeURIComponent(s.whatsappMessage || `Hola, busco ${s.title}`)}`} target="_blank" class="hover:text-brand-primary transition-colors">{s.title}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="text-base font-bold text-white mb-3">Contacto</h4>
        <ul class="space-y-1.5 text-xs">
          <li>{siteData.contact.address}</li>
          <li>Tel: {siteData.contact.phone}</li>
          {siteData.contact.email && <li>Email: {siteData.contact.email}</li>}
        </ul>
      </div>
    </div>
    <div class="border-t border-gray-800 pt-6 text-center text-xs text-gray-500">
      &copy; {year} {siteData.name}. Todos los derechos reservados.
    </div>
  </div>
</footer>
