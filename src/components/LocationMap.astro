---
import { getSiteData } from '../data/getSiteData';
const siteData = await getSiteData();
---

<section class="py-20 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="bg-white rounded-3xl overflow-hidden shadow-xl border border-gray-100 flex flex-col lg:flex-row">
      <div class="lg:w-1/3 p-8 lg:p-12 flex flex-col justify-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">{siteData.sectionTitles?.location || 'Visítanos'}</h2>
        
        <div class="space-y-6 mb-10">
          <div class="flex items-start gap-4">
            <div class="bg-brand-primary/10 p-3 rounded-xl text-brand-primary mt-1">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <div>
              <p class="font-bold text-gray-900 mb-1">Dirección</p>
              <p class="text-gray-600">{siteData.contact.address}</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="bg-brand-primary/10 p-3 rounded-xl text-brand-primary mt-1">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <p class="font-bold text-gray-900 mb-1">Horario</p>
              {siteData.schedule?.summary?.map(line => (
                <p class="text-gray-600">{line}</p>
              ))}
            </div>
          </div>
        </div>
        
        <a href={siteData.contact.mapsUrl} target="_blank" rel="noopener noreferrer" class="bg-brand-primary text-white text-center font-bold px-6 py-4 rounded-xl hover:bg-brand-secondary transition-colors">
          Cómo llegar en GPS
        </a>
      </div>
      <div class="lg:w-2/3 h-96 lg:h-auto min-h-[400px] bg-gray-200">
        <!-- Generic Google Maps iframe for Mérida -->
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d119213.91136458269!2d-89.69742616235125!3d20.98015545233157!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f56715c7a6e1333%3A0xc6c42938a1be52e7!2sM%C3%A9rida%2C%20Yuc.!5e0!3m2!1sen!2smx!4v1700000000000!5m2!1sen!2smx" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>
